# Crate Digger behind Caddy.
#
# Port 443 is already open and already has a certificate — it is serving
# Restock. Hanging Crate Digger off a PATH on that same port needs no new
# firewall rule, no DNS record and no second certificate, which is three
# fewer things that can be wrong.
#
# MERGE this into the site block you already have. Do not add a second block
# for the same hostname — Caddy will refuse the config.

0iu6eih.cserverhost.cloud {
    encode zstd gzip

    # Without this, /crate loads a page whose relative asset URLs resolve one
    # level too high and nothing loads. The trailing slash is load-bearing.
    redir /crate /crate/ 308

    # handle_path strips the prefix, so the app still sees /api/... and needs
    # no idea it is mounted anywhere. Set CRATE_BASE_PATH=/crate in .env so
    # its redirects point back here.
    handle_path /crate/* {
        reverse_proxy 127.0.0.1:8770 {
            transport http {
                # Records stream and drag out from here: a 100 MB FLAC over a
                # slow line is normal, not a stall.
                read_timeout 600s
            }
        }
    }

    # Everything else stays with Restock, exactly as before. `handle` blocks
    # are mutually exclusive and tried in order, so this only sees what /crate
    # did not claim.
    handle {
        reverse_proxy 127.0.0.1:8003
    }
}

# ── The old approach, kept for reference ──────────────────────────────
# A separate port needs the port opened in BOTH ufw and the IONOS cloud
# firewall (a separate policy in the IONOS control panel, which ufw cannot
# touch). That second one is easy to miss, and its symptom — connections that
# hang rather than refuse — looks exactly like the app being down.
#
# 0iu6eih.cserverhost.cloud:8443 {
#     reverse_proxy 127.0.0.1:8770
# }
